{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:webassistant:appsettings:schema",
  "title": "WebAssistant appsettings.json",
  "description": "Машиночитаемая проекция package/runtime JSON-конфигурации WebAssistant. Стандартные внешние configuration providers ASP.NET Core описаны в docs/configuration.md.",
  "type": "object",
  "properties": {
    "Logging": {
      "type": "object",
      "description": "Стандартная конфигурация журналирования .NET/ASP.NET Core.",
      "properties": {
        "LogLevel": {
          "type": "object",
          "properties": {
            "Default": {
              "type": "string",
              "default": "Information"
            },
            "WebAssistant": {
              "type": "string",
              "default": "Information"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "WebAssistant": {
      "type": "object",
      "properties": {
        "Port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 17654,
          "description": "Loopback HTTP port. Адрес listener не настраивается."
        },
        "LogDirectory": {
          "type": "string",
          "default": "",
          "description": "Пустое/отсутствующее значение выбирает platform default."
        },
        "Cors": {
          "type": "object",
          "properties": {
            "Enabled": {
              "type": "boolean",
              "default": false
            },
            "AllowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [],
              "description": "Runtime принимает только exact HTTP/HTTPS origins без wildcard, user-info, path, query и fragment."
            }
          },
          "additionalProperties": true
        },
        "FileSystem": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "Полностью квалифицированный physical root path; platform-specific absolute-path validation выполняется runtime."
          },
          "description": "Map logicalRootName -> physicalRootPath. Case-only duplicate names запрещены runtime и не выражаются стандартным JSON Schema."
        }
      },
      "additionalProperties": true
    },
    "urls": {
      "type": "string",
      "maxLength": 0,
      "description": "WebAssistant запрещает непустое альтернативное listener configuration."
    },
    "http_ports": {
      "type": "string",
      "maxLength": 0,
      "description": "WebAssistant запрещает непустое альтернативное listener configuration."
    },
    "https_ports": {
      "type": "string",
      "maxLength": 0,
      "description": "WebAssistant запрещает непустое альтернативное listener configuration."
    },
    "Kestrel": {
      "type": "object",
      "properties": {
        "Endpoints": {
          "type": "object",
          "maxProperties": 0,
          "description": "Произвольные Kestrel endpoints запрещены WebAssistant."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
