{
  // Этот файл — всегда свежий пример для установленной версии WebAssistant.
  // Рабочие настройки находятся в appsettings.json рядом с этим файлом.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WebAssistant": "Debug"
    }
  },
  "WebAssistant": {
    "Port": 17654,
    "LogDirectory": "C:/ProgramData/WebAssistant/logs",
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [
        "http://127.0.0.1:8080",
        "http://localhost:8080"
      ]
    },
    "FileSystem": {
      "documents": "C:/Documents",
      "archive": "D:\Archive",
      "programs": "C:\\Program Files\\Example App",
      "network": "\\server\share\import"
    }
  }
}
