<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="netkeep80.WebAssistant"
      Name="WebAssistant"
      Manufacturer="WebAssistant"
      Version="$(var.ProductVersion)"
      Scope="perMachine">

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WebAssistant" />
    </StandardDirectory>

    <Files Include="$(var.PayloadRoot)\**" Directory="INSTALLFOLDER">
      <Exclude Files="$(var.PayloadRoot)\WebAssistant.exe" />
    </Files>

    <Component Id="WebAssistantServiceComponent" Directory="INSTALLFOLDER" Guid="*">
      <File
          Id="WebAssistantServiceExecutable"
          Source="$(var.PayloadRoot)\WebAssistant.exe"
          KeyPath="yes" />
      <ServiceInstall
          Id="WebAssistantServiceInstall"
          Name="WebAssistant"
          DisplayName="WebAssistant"
          Description="WebAssistant local service"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal" />
      <ServiceControl
          Id="WebAssistantServiceControl"
          Name="WebAssistant"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>
  </Package>
</Wix>
