<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
      Id="netkeep80.WebAssistant.Bundle"
      Name="WebAssistant"
      Manufacturer="WebAssistant"
      Version="$(var.ProductVersion)"
      Compressed="yes">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage
          Id="UpgradePreflight"
          SourceFile="$(var.PreflightPath)"
          DetectCondition="0"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          RepairArguments="" />
      <MsiPackage
          Id="WebAssistantMsi"
          SourceFile="$(var.MsiPath)"
          Visible="no"
          ForcePerMachine="yes"
          Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
