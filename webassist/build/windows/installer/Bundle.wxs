<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
      Id="netkeep80.WebAssistant.Bundle"
      Name="$(var.ProductDisplayName)"
      Manufacturer="$(var.ProductCompanyName)"
      Version="$(var.ProductVersion)"
      IconSourceFile="$(var.BundleIconPath)"
      Compressed="yes">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl=""
          LocalizationFile="$(var.LocalizationFile)"
          LogoFile="$(var.LogoFile)" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage
          Id="UpgradePreflight"
          SourceFile="$(var.PreflightPath)"
          DetectCondition="0"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          RepairArguments="" />
      <MsiPackage
          Id="WebAssistantMsi"
          SourceFile="$(var.MsiPath)"
          Visible="no"
          ForcePerMachine="yes"
          Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
