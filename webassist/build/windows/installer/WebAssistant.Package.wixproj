<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>WebAssistant.Package</OutputName>
    <DefineConstants>$(DefineConstants);PayloadRoot=$(PayloadRoot);ProductVersion=$(ProductVersion);ProductDisplayName=$(ProductDisplayName);ProductCompanyName=$(ProductCompanyName);ProductFileDescription=$(ProductFileDescription)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bundle.wxs" />
  </ItemGroup>
</Project>
