<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>WebAssistant.Bundle</OutputName>
    <DefineConstants>$(DefineConstants);MsiPath=$(MsiPath);PreflightPath=$(PreflightPath);ProductVersion=$(ProductVersion);ProductDisplayName=$(ProductDisplayName);ProductCompanyName=$(ProductCompanyName);ProductFileDescription=$(ProductFileDescription);LocalizationFile=$(LocalizationFile);BundleIconPath=$(BundleIconPath);LogoFile=$(LogoFile)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Package.wxs" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
