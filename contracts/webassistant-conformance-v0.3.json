  "vectors": [
    {
      "id": "WA-C-AUTONOMOUS-ROOT-001",
      "kind": "positive",
      "assertion": "Экспортированное содержимое webassist остаётся самостоятельным product root и проходит restore/build/package без файлов родительского development repository.",
      "requirements": ["WA-REPO-001", "WA-REPO-002"],
      "evidence": ["tests/core/PackagingLayoutTests.cs", "tests/core/ProductAutonomyTests.cs", "tests/core/IsolatedExportRootAcceptanceTests.cs", ".github/workflows/linux-systemd.yml", ".github/workflows/windows-service.yml"]
    },
    {
      "id": "WA-C-PRODUCT-LOCAL-CI-001",
      "kind": "positive",
      "assertion": "Автономный product root содержит собственный .gitlab-ci.yml и этот CI entrypoint сохраняется после copy-export.",
      "requirements": ["WA-CI-001", "WA-REPO-001"],
      "evidence": ["webassist/.gitlab-ci.yml", "tests/core/ProductAutonomyTests.cs", "tests/core/IsolatedExportRootAcceptanceTests.cs"]
    },
    {
      "id": "WA-C-SERVICE-LIFECYCLE-001",
      "kind": "positive",
      "assertion": "WebAssistant устанавливается и работает как machine-wide Windows Service и ALT Linux systemd service через canonical product entrypoints.",
      "requirements": ["WA-SERVICE-001", "WA-SERVICE-002"],
      "evidence": ["tests/core/SystemServiceProductTests.cs", "tests/core/WindowsPowerShellCompatibilityTests.cs", ".github/workflows/linux-systemd.yml", ".github/workflows/windows-service.yml"]
    },
    {
      "id": "WA-C-LOOPBACK-001",
      "kind": "negative",
      "assertion": "Listener остаётся loopback-only, а альтернативные configuration mechanisms не могут открыть LAN/0.0.0.0 listener.",
      "requirements": ["WA-NET-001"],
      "evidence": ["tests/core/RuntimeOptionsTests.cs", "tests/windows-service/run-service-acceptance.ps1", "tests/linux-systemd/run-systemd-acceptance.sh"]
    },
    {
      "id": "WA-C-VERSIONED-API-001",
      "kind": "negative",
      "assertion": "Machine REST API используется под /v1, а unversioned /health и /scan не существуют; service panel остаётся на /.",
      "requirements": ["WA-API-001", "WA-API-002"],
      "evidence": ["tests/core/HttpScanContractTests.cs", "tests/core/PlatformEndToEndTests.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-DISCOVERY-001",
      "kind": "positive",
      "assertion": "GET /v1/scanners возвращает нормализованные scanner endpoints со stable scannerId и capabilities; на Windows WIA и TWAIN перечисляются независимо, partial backend failures видимы через warnings, а неоднозначная native identity отклоняется fail-closed.",
      "requirements": ["WA-SCAN-001"],
      "evidence": ["tests/core/HttpScanContractTests.cs", "tests/core/ScannerIdentityTests.cs", "tests/core/LinuxScanAdapterTests.cs", "tests/core/LinuxVirtualScanAdapterTests.cs", "tests/core/WindowsScanAdapterTests.cs", ".github/workflows/virtual-scanner.yml", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-HTTP-001",
      "kind": "positive",
      "assertion": "POST /v1/scan является единственным acquisition route, принимает JSON с обязательным stable scannerId, exact source auto|flatbed|feeder и normalized settings, применяет явные 400/404/409/422/502/503 outcomes и возвращает raw application/pdf при успехе.",
      "requirements": ["WA-SCAN-001", "WA-SCAN-002", "WA-SCAN-003", "WA-SCAN-006", "WA-TRANSPORT-001"],
      "evidence": ["tests/core/HttpScanContractTests.cs", "tests/core/ScannerSettingsHttpContractTests.cs", "tests/core/PlatformEndToEndTests.cs", "tests/core/ServicePanelScannerApiTests.cs", ".github/workflows/virtual-scanner.yml", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-AUTO-001",
      "kind": "positive",
      "assertion": "WebAssistant-owned auto policy выбирает feeder только при PRESENT; для dual-source ABSENT и UNKNOWN выбирают flatbed, UNKNOWN не считается PRESENT, explicit source не имеет fallback, а unsupported source/duplex отклоняется до acquisition.",
      "requirements": ["WA-SCAN-002"],
      "evidence": ["tests/core/ScanSourcePolicyTests.cs", "tests/core/HttpScanContractTests.cs", "tests/core/WindowsScanAdapterTests.cs", ".github/workflows/virtual-scanner.yml", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-STATELESS-001",
      "kind": "negative",
      "assertion": "scannerId детерминированно выводится из backend и exact native identity и может сохраняться caller'ом между restart/reboot; WebAssistant не хранит mutable scanner profile, выбранный scannerId, source или settings и при acquisition заново разрешает endpoint stateless.",
      "requirements": ["WA-SCAN-001", "WA-SCAN-002", "WA-SCAN-006"],
      "evidence": ["tests/core/ScannerIdentityTests.cs", "tests/core/WindowsScanAdapterTests.cs", "tests/core/LinuxScanAdapterTests.cs", "tests/core/HttpScanContractTests.cs", "tests/core/ScannerSettingsHttpContractTests.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-SETTINGS-001",
      "kind": "positive",
      "assertion": "Canonical scanner-settings schema и GET /v1/scanners/{scannerId}/settings позволяют получить normalized dpi/colorMode/paperSize capabilities по public request modes; auto projection является пересечением возможностей concrete sources, defaults детерминированы, invalid syntax получает 400, а valid unsupported value получает 422 до acquisition.",
      "requirements": ["WA-SCAN-006"],
      "evidence": ["webassist/docs/scanner-settings.schema.json", "tests/core/ScannerSettingsSchemaTests.cs", "tests/core/ScannerCapabilityProjectionTests.cs", "tests/core/ScannerSettingsHttpContractTests.cs", "webassist/src/WebAssistant/Http/ScannerSettingsEndpointHandlers.cs", "webassist/src/WebAssistant/Scanning/ScannerCapabilityProjection.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-PANEL-001",
      "kind": "positive",
      "assertion": "Diagnostic panel строит scanner mode/settings controls из canonical schema и projection выбранного scannerId, использует один Scan action и read-only scanner information без WIA/TWAIN/SANE/model-specific UI правил.",
      "requirements": ["WA-SCAN-006", "WA-SCAN-007"],
      "evidence": ["webassist/src/WebAssistant/wwwroot/index.html", "tests/core/ScannerSettingsPanelContractTests.cs", "tests/core/ServicePanelScannerApiTests.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-MULTIPAGE-001",
      "kind": "positive",
      "assertion": "Все страницы одного acquisition включаются в один PDF до handoff вызывающей стороне.",
      "requirements": ["WA-SCAN-004"],
      "evidence": ["tests/core/PlatformEndToEndTests.cs", ".github/workflows/virtual-scanner.yml", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-RAW-PDF-TRANSPORT-001",
      "kind": "negative",
      "assertion": "Успешный scan передаёт binary application/pdf напрямую; Base64, JSON document envelope и ZIP/raster envelope не являются scanner transport.",
      "requirements": ["WA-SCAN-001", "WA-TRANSPORT-001"],
      "evidence": ["tests/core/HttpScanContractTests.cs", "tests/core/PlatformEndToEndTests.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-BOUNDARY-001",
      "kind": "negative",
      "assertion": "Scanner operation заканчивается после PDF handoff и не превращает завершённый scan document в long-term scanner storage.",
      "requirements": ["WA-SCAN-004"],
      "evidence": ["tests/core/HttpScanContractTests.cs", "webassist/src/WebAssistant/Http/ScannerEndpointHandlers.cs", "webassist/src/WebAssistant/Http/ScanCoordinator.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-SCANNER-EXCLUSIONS-001",
      "kind": "negative",
      "assertion": "Scanner operation не выполняет PDF editing/merge/split, OCR/annotation/watermark/deskew/semantic transformation, signing/encryption, business/backend upload и не требует business authentication/per-user business profile.",
      "requirements": ["WA-SCAN-005"],
      "evidence": ["webassist/src/WebAssistant/Http/ScannerEndpointHandlers.cs", "webassist/src/WebAssistant/Http/ScanCoordinator.cs", "tests/core/HttpScanContractTests.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-DIAGNOSTICS-001",
      "kind": "negative",
      "assertion": "Diagnostics ограничена безопасной runtime-информацией и собственными daily logs; arbitrary paths и document contents в logs запрещены.",
      "requirements": ["WA-DIAG-001", "WA-LOG-001"],
      "evidence": ["tests/core/DiagnosticsContractTests.cs", "tests/core/RequestLoggingMiddlewareTests.cs"]
    },
    {
      "id": "WA-C-DAILY-LOG-001",
      "kind": "negative",
      "assertion": "WebAssistant пишет собственные daily log files и current logger не выполняет automatic retention/delete старых daily logs.",
      "requirements": ["WA-LOG-002"],
      "evidence": ["tests/core/DiagnosticsContractTests.cs", "webassist/src/WebAssistant/Logging/DailyFileLoggerProvider.cs", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-CORS-001",
      "kind": "negative",
      "assertion": "CORS default-off; только explicit exact HTTP/HTTPS origins разрешаются, wildcard не допускается.",
      "requirements": ["WA-CORS-001"],
      "evidence": ["tests/core/CorsConfigurationTests.cs", "tests/core/ConfigurationOwnershipTests.cs"]
    },
    {
      "id": "WA-C-ROOTED-FILESYSTEM-001",
      "kind": "negative",
      "assertion": "Filesystem resolution остаётся внутри configured root, обход boundary отвергается, browser-facing filesystem routes в current baseline отсутствуют.",
      "requirements": ["WA-FS-001", "WA-FS-002"],
      "evidence": ["tests/core/RootedPathResolverTests.cs", "tests/core/HttpScanContractTests.cs"]
    },
    {
      "id": "WA-C-DEPENDENCY-OWNERSHIP-001",
      "kind": "negative",
      "assertion": "Production использует repository-owned fixed WebAssistant.NAPS2.Sdk с pinned integrity/provenance и не может молча заменить его official unfixed SDK.",
      "requirements": ["WA-DEPS-001"],
      "evidence": ["tests/core/DependencyOwnershipTests.cs", "webassist/vendor/naps2/README.md", "webassist/NuGet.Config"]
    },
    {
      "id": "WA-C-PRODUCT-DOCS-001",
      "kind": "positive",
      "assertion": "Canonical product documentation находится внутри autonomous product root и описывает current API/build/install/runtime surfaces.",
      "requirements": ["WA-DOC-001", "WA-REPO-002"],
      "evidence": ["webassist/README.md", "webassist/docs/api.md", "webassist/docs/linux-service.md", "webassist/docs/windows-service.md", "tests/core/ProductAutonomyTests.cs"]
    },
    {
      "id": "WA-C-LANGUAGE-POLICY-001",
      "kind": "positive",
      "assertion": "Новая и изменяемая документация и source comments следуют русской language policy с допустимыми нерусскими technical identifiers/terms.",
      "requirements": ["WA-DOC-002"],
      "evidence": ["README.md", "webassist/README.md", "webassist/docs/api.md"]
    },
    {
      "id": "WA-C-DIST-PRODUCERS-001",
      "kind": "positive",
      "assertion": "Distribution candidate требует, чтобы пять execution scenarios сходились к двум canonical repository-owned producer entrypoints и двум versioned installer artifacts без CI-specific product packaging implementation.",
      "requirements": ["WA-DIST-001"],
      "evidence": ["tests/core/DistributionContractCandidateTests.cs", "tests/core/InstallerArtifactContractTests.cs", "tests/core/CiWorkflowContractTests.cs", "webassist/build/linux/package.sh", "webassist/build/windows/package.bat", ".github/workflows/linux-systemd.yml", ".github/workflows/windows-service.yml", ".github/workflows/build-installers.yml", ".github/workflows/ci.yml"]
    },
    {
      "id": "WA-C-DIST-VERSION-IDENTITY-001",
      "kind": "negative",
      "assertion": "Distribution candidate требует exact versioned filenames и единую VERSION identity между webassist/VERSION, filename, application metadata, installer/package metadata и release/tag; mismatch обязан блокировать install/release fail-closed.",
      "requirements": ["WA-DIST-002"],
      "evidence": ["tests/core/DistributionContractCandidateTests.cs", "tests/core/InstallerArtifactContractTests.cs", "tests/windows-service/run-installer-acceptance.ps1", "tests/linux-systemd/run-installer-acceptance.sh", ".github/workflows/build-installers.yml", ".github/workflows/installer-acceptance.yml"]
    },
    {
      "id": "WA-C-PACKAGE-CONFIG-001",
      "kind": "negative",
      "assertion": "Distribution candidate фиксирует package-time config selection: source appsettings exact bytes при наличии либо safe default при отсутствии; после package formation installer не может заменить или изменить packaged config.",
      "requirements": ["WA-DIST-003"],
      "evidence": ["tests/core/DistributionContractCandidateTests.cs", "tests/core/ConfigurationOwnershipTests.cs", "webassist/build/common/default-appsettings.json", "webassist/build/windows/package.ps1", "webassist/build/linux/package.sh", "tests/windows-service/run-installer-acceptance.ps1", "tests/linux-systemd/run-installer-acceptance.sh"]
    },
    {
