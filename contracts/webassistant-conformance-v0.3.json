      "evidence": ["tests/core/DistributionContractCandidateTests.cs", "tests/core/SystemServiceProductTests.cs", "webassist/build/windows/installer/Package.wxs", "webassist/build/windows/installer/Bundle.wxs", "tests/windows-service/run-installer-acceptance.ps1", ".github/workflows/windows-service.yml", ".github/workflows/build-installers.yml", ".github/workflows/installer-acceptance.yml"]
    },
    {
