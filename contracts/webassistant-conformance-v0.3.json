      "requirements": ["WA-DIST-004"],
      "evidence": ["tests/core/DistributionContractCandidateTests.cs", "webassist/build/windows/package.ps1", "webassist/build/linux/package.sh", ".github/workflows/windows-service.yml", ".github/workflows/linux-systemd.yml", ".github/workflows/build-installers.yml", ".github/workflows/installer-acceptance.yml"]
    },
