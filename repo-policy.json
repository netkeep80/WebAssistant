{
  "policy_format_version": "0.3.0",
  "repository_kind": "application",
  "enforcement": {
    "mode": "blocking"
  },
  "contract_conformance": {
    "current": {
      "contract": {
        "path": "contracts/webassistant-contract-v0.2.json",
        "format": "json"
      },
      "conformance": {
        "path": "contracts/webassistant-conformance-v0.2.json",
        "format": "json"
      }
    },
    "pair_fields": {
      "contract_id": "/schema",
      "conformance_contract_id": "/contract",
      "contract_conformance_path": "/conformanceCorpus",
      "contract_status": "/status",
      "conformance_status": "/status",
      "contract_accepted": "/accepted",
      "conformance_accepted": "/accepted"
    },
    "accepted_state": {
      "status": "accepted",
      "accepted": true
    },
    "required_paths": [
      {
        "document": "current.conformance",
        "pointer": "/requiredRepositoryPaths",
        "projection": "array_items"
      }
    ],
    "cochange": [
      "current.contract",
      "current.conformance"
    ],
    "control_paths": [
      "contracts/webassistant-contract-v*.json",
      "contracts/webassistant-conformance-v*.json"
    ]
  },
  "document_relations": {
    "documents": {
      "base-product-version": {
        "path": "webassist/VERSION",
        "format": "plain_text",
        "snapshot": "base"
      },
      "head-product-version": {
        "path": "webassist/VERSION",
        "format": "plain_text",
        "snapshot": "head"
      },
      "repo-guard-workflow": {
        "path": ".github/workflows/repo-guard.yml",
        "format": "yaml"
      }
    },
    "rules": [
      {
        "id": "product-version-monotonic",
        "kind": "scalar_strictly_greater",
        "comparator": "semver",
        "left": {
          "document": "head-product-version",
          "pointer": "",
          "type": "string"
        },
        "right": {
          "document": "base-product-version",
          "pointer": "",
          "type": "string"
        }
      },
      {
        "id": "repo-guard-workflow-action-pin",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/repo-guard/steps/1/uses",
          "type": "string"
        },
        "value": "netkeep80/repo-guard@e5b9063c9d1c9e05404ec32b78ca005c278839ce"
      },
      {
        "id": "repo-guard-workflow-mode",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/repo-guard/steps/1/with/mode",
          "type": "string"
        },
        "value": "check-pr"
      },
      {
        "id": "repo-guard-workflow-enforcement",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/repo-guard/steps/1/with/enforcement",
          "type": "string"
        },
        "value": "blocking"
      },
      {
        "id": "repo-guard-workflow-permission-contents",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/contents",
          "type": "string"
        },
        "value": "read"
      },
      {
        "id": "repo-guard-workflow-permission-pull-requests",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/pull-requests",
          "type": "string"
        },
        "value": "read"
      },
      {
        "id": "repo-guard-workflow-permission-issues",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/issues",
          "type": "string"
        },
        "value": "read"
      }
    ]
  },
  "paths": {
    "forbidden": [
      "*.bak",
      "*.tmp",
      "*.orig"
    ],
    "canonical_docs": [
      "README.md",
      "webassist/README.md"
    ],
    "governance_paths": [
      "repo-policy.json",
      "contracts/**",
      ".github/workflows/**",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE/**"
    ],
    "operational_paths": []
  },
  "diff_rules": {
    "max_new_docs": 3,
    "max_new_files": 20,
    "max_net_added_lines": 2500
  },
  "content_rules": [
    {
      "id": "standalone-product-no-parent-governance-references",
      "glob": "webassist/**",
      "mode": "added_lines",
      "forbid_regex": [
        "netkeep80/WebAssistant",
        "repo-policy\\.json",
        "\\.github/workflows/",
        "docs/superpowers/",
        "contracts/webassistant-"
      ]
    },
    {
      "id": "no-legacy-or-environment-identities",
      "glob": "**",
      "mode": "added_lines",
      "forbid_regex": [
        "ScannerAgent",
        "tmk5scan",
        "Triumf",
        "depfin\\.nnov\\.ru"
      ]
    }
  ],
  "cochange_rules": [
    {
      "if_changed": [
        "webassist/src/WebAssistant/Program.cs",
        "webassist/src/WebAssistant/Http/ApiVersion.cs",
        "webassist/src/WebAssistant/Http/ScannerEndpointHandlers.cs",
        "webassist/src/WebAssistant/Http/ScanCoordinator.cs"
      ],
      "must_change_any": [
        "webassist/docs/api.md"
      ]
    }
  ]
}
